  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Total Connected APs",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT device_id) AS \"total_aps\"\nFROM telemetry\nWHERE $__timeFilter(event_time)\n  AND device_id IS NOT NULL;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "title": "Connected AP List & Status",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  device_id AS \"AP Name\",\n  ap_mac AS \"MAC Address\",\n  firmware_version AS \"Firmware\",\n  MAX(event_time) AS \"Last Seen\",\n  MAX(connected_clients) AS \"Current Clients\"\nFROM telemetry\nWHERE $__timeFilter(event_time)\n  AND device_id IS NOT NULL\nGROUP BY device_id, ap_mac, firmware_version\nORDER BY \"Last Seen\" DESC;",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "title": "Connected Clients per AP",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(event_time, $__interval),\n  device_id AS metric,\n  MAX(connected_clients) AS \"value\"\nFROM telemetry\nWHERE $__timeFilter(event_time)\n  AND device_id IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1 ASC;",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": ["metric"]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 4,
      "title": "CPU & Memory Utilization (%)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(event_time, $__interval),\n  device_id || ' CPU' AS metric,\n  AVG(cpu_utilization_pct) AS \"value\"\nFROM telemetry\nWHERE $__timeFilter(event_time)\n  AND device_id IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1 ASC;",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(event_time, $__interval),\n  device_id || ' RAM' AS metric,\n  AVG(memory_utilization_pct) AS \"value\"\nFROM telemetry\nWHERE $__timeFilter(event_time)\n  AND device_id IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1 ASC;",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": ["metric"]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "spanNulls": true
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 5,
      "title": "Noise Floor (dBm)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(event_time, $__interval),\n  device_id AS metric,\n  AVG(noise_floor_dbm) AS \"value\"\nFROM telemetry\nWHERE $__timeFilter(event_time)\n  AND device_id IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1 ASC;",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": ["metric"]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "spanNulls": true
          },
          "unit": "dBm"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ],
